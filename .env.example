# Copy to .env (git-ignored); development only. Placeholders, not real secrets.
POSTGRES_PASSWORD=change-me

# Development seed user, created at startup only when ASPNETCORE_ENVIRONMENT=Development.
AUTH_DEV_SEED_EMAIL=user@example.com
AUTH_DEV_SEED_PASSWORD=change-me-Dev-1

# Second development seed user, created with an UNCONFIRMED email (spec 0004). Used by scripts/e2e-email.sh.
AUTH_DEV_SEED_UNVERIFIED_EMAIL=new@example.com
AUTH_DEV_SEED_UNVERIFIED_PASSWORD=Dev-Unverified-Passw0rd

# Password of the "notes" database login of the sample product (samples/notes-api). Letters, digits and hyphens only: it goes
# into a URL. Used by the compose overlay (docker compose -f deploy/docker-compose.yml -f samples/notes-api/compose.yml).
NOTES_DB_PASSWORD=change-me-notes
