{
  "ConnectionStrings": {
    "Auth": "Host=localhost;Port=5432;Database=auth;Username=auth"
  },
  "Auth": {
    "Database": {
      "MigrateOnStartup": true
    },
    "Manifest": {
      "Path": "../../deploy/auth.yaml"
    },
    "App": {
      "Name": "auth-core-dev",
      "Locale": "en",
      "FrontendUrls": {
        "ResetPassword": "http://localhost:4200/reset",
        "VerifyEmail": "http://localhost:4200/verify",
        "AcceptInvite": "http://localhost:4200/invite"
      }
    },
    "Email": {
      "From": "no-reply@auth-core.localhost",
      "Smtp": {
        "Host": "localhost",
        "Port": 1025,
        "Security": "none"
      }
    }
  }
}
