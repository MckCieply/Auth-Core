# One origin for the browser: /auth is Auth-Core, /api is the notes service. Plain HTTP, development only.
{
	admin off
	auto_https off
}

http://:8088 {
	handle /auth/* {
		# Auth-Core limits and records requests per client address (spec 0008). Caddy sets X-Forwarded-For to the address it saw and
		# X-Forwarded-Proto to the scheme, and drops what a client wrote into them, because this file names no trusted_proxies
		# (Caddy 2.5+); step 7 of scripts/e2e-notes.sh proves it.
		reverse_proxy auth:8080
	}
	handle /api/* {
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
		}
		reverse_proxy notes-api:8000
	}
	handle {
		respond "not found" 404
	}
}
